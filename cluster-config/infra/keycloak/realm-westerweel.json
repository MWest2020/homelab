{
  "realm": "westerweel",
  "displayName": "Westerweel homelab",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "resetPasswordAllowed": false,
  "loginWithEmailAllowed": true,
  "clients": [
    {
      "clientId": "wanderer",
      "name": "Wanderer",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "secret": "${WANDERER_CLIENT_SECRET}",
      "redirectUris": [
        "https://wanderer.westerweel.work/ui/oauth/callback"
      ],
      "webOrigins": [
        "https://wanderer.westerweel.work"
      ],
      "fullScopeAllowed": true,
      "attributes": {
        "post.logout.redirect.uris": "https://wanderer.westerweel.work/ui/*"
      }
    },
    {
      "clientId": "wordsworth",
      "name": "Wordsworth",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "secret": "${WORDSWORTH_CLIENT_SECRET}",
      "redirectUris": [
        "https://wordsworth.westerweel.work/oauth2/callback"
      ],
      "webOrigins": [
        "https://wordsworth.westerweel.work"
      ],
      "fullScopeAllowed": true,
      "attributes": {
        "post.logout.redirect.uris": "https://wordsworth.westerweel.work/*"
      }
    }
  ],
  "duplicateEmailsAllowed": false,
  "rememberMe": true,
  "verifyEmail": false,
  "editUsernameAllowed": false,
  "passwordPolicy": "length(12) and notUsername(undefined) and notEmail(undefined) and passwordHistory(3)",
  "bruteForceProtected": true,
  "permanentLockout": false,
  "failureFactor": 10,
  "waitIncrementSeconds": 60,
  "maxFailureWaitSeconds": 900,
  "maxDeltaTimeSeconds": 43200,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "accessTokenLifespan": 300,
  "offlineSessionIdleTimeout": 2592000,
  "browserSecurityHeaders": {
    "contentSecurityPolicy": "frame-src 'self'; frame-ancestors 'self'; object-src 'none';",
    "xFrameOptions": "SAMEORIGIN",
    "strictTransportSecurity": "max-age=31536000; includeSubDomains",
    "xContentTypeOptions": "nosniff",
    "referrerPolicy": "no-referrer"
  },
  "roles": {
    "realm": [
      {
        "name": "beheer",
        "description": "Beheer van het homelab: mag alles in de aangesloten apps."
      },
      {
        "name": "lezer",
        "description": "Mag meekijken: rapporten en consoles lezen, niets wijzigen."
      }
    ]
  },
  "defaultRoles": [
    "lezer"
  ],
  "otpPolicyType": "totp",
  "otpPolicyAlgorithm": "HmacSHA1",
  "otpPolicyDigits": 6,
  "otpPolicyPeriod": 30,
  "otpPolicyLookAheadWindow": 1,
  "requiredActions": [
    {
      "alias": "CONFIGURE_TOTP",
      "name": "Configure OTP",
      "providerId": "CONFIGURE_TOTP",
      "enabled": true,
      "defaultAction": true,
      "priority": 10,
      "config": {}
    }
  ]
}
