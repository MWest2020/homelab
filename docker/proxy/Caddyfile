# NOTE: This is a static reference copy.
# The deployed Caddyfile is generated by Ansible from templates/Caddyfile.j2

{
	order crowdsec first
	crowdsec {
		api_url http://crowdsec:8080
		api_key {env.CROWDSEC_API_KEY}
		ticker_interval 15s
	}
}

(secured) {
	log {
		output file /var/log/caddy/access.log {
			roll_size 20MiB
			roll_keep 5
		}
		format json
	}
	crowdsec
}

# React frontends (public)
klant-a.woo.westerweel.work {
	import secured
	tls internal
	reverse_proxy woo-klant-a:8080
}

klant-b.woo.westerweel.work {
	import secured
	tls internal
	reverse_proxy woo-klant-b:8080
}

klant-c.woo.westerweel.work {
	import secured
	tls internal
	reverse_proxy woo-klant-c:8080
}

