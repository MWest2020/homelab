# Buzz-relay environment (boomhuis, tailnet-only).
# Kopieer naar /opt/buzz-relay/.env (mode 0600) en vervang elke placeholder-waarde.
# De deploy-playbook seedt dit bestand als het nog niet bestaat.
# Genereren van random waarden op de host:  openssl rand -hex 32

# Gepind image (nooit :main/:latest). Upgrade = bewuste pin-wijziging in git.
# sha-4baccd5 == digest sha256:ba442140f37d... (main van 2026-08-22)
BUZZ_IMAGE=ghcr.io/block/buzz:sha-4baccd5

# Geen publieke domein/TLS: de relay is alleen via LAN + tailnet-/32 bereikbaar.
# ws:// (geen wss): transport-encryptie komt van Tailscale/WireGuard.
BUZZ_DOMAIN=192.168.178.60
RELAY_URL=ws://192.168.178.60:3000
BUZZ_MEDIA_BASE_URL=http://192.168.178.60:3000/media
BUZZ_MEDIA_SERVER_DOMAIN=192.168.178.60
BUZZ_CORS_ORIGINS=http://192.168.178.60:3000

# Productie-defaults: gesloten relay (alleen leden, owner-pubkey verplicht).
BUZZ_REQUIRE_AUTH_TOKEN=true
BUZZ_REQUIRE_RELAY_MEMBERSHIP=true
BUZZ_ALLOW_NIP_OA_AUTH=true
BUZZ_AUTO_MIGRATE=true
BUZZ_GIT_CONFORMANCE_PROBE=true
RUST_LOG=buzz_relay=info,buzz_db=info,buzz_auth=info,buzz_pubsub=info,tower_http=info

# Owner-identiteit: Marks Nostr-pubkey, 64 hex chars (uit boomhuis identities.yml).
RELAY_OWNER_PUBKEY=CHANGE_ME_OWNER_PUBKEY_HEX

# Stabiele secrets: één keer genereren, in .env houden, veilig backuppen.
# BUZZ_RELAY_PRIVATE_KEY is de relay-identiteit — verlies = alle clients opnieuw.
BUZZ_RELAY_PRIVATE_KEY=CHANGE_ME_64_HEX_PRIVATE_KEY
BUZZ_GIT_HOOK_HMAC_SECRET=CHANGE_ME_RANDOM_64_HEX
POSTGRES_DB=buzz
POSTGRES_USER=buzz
POSTGRES_PASSWORD=CHANGE_ME_RANDOM_PASSWORD
REDIS_PASSWORD=CHANGE_ME_RANDOM_PASSWORD
BUZZ_S3_ACCESS_KEY=CHANGE_ME_RANDOM_ACCESS_KEY
BUZZ_S3_SECRET_KEY=CHANGE_ME_RANDOM_SECRET_KEY
BUZZ_S3_BUCKET=buzz-media
BUZZ_S3_ADDRESSING_STYLE=path

BUZZ_HTTP_PORT=3000
